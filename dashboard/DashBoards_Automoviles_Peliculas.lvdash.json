    {
      "name": "77a4a345",
      "displayName": "peliculas",
      "config": {
        "version": "1.1",
        "source": "smartdata_jeol.gold.peliculas",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7235f486",
      "displayName": "automoviles_resumen",
      "config": {
        "version": "1.1",
        "source": "smartdata_jeol.gold.automoviles_resumen",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "45ecf8ce",
      "displayName": "top_10_peliculas",
      "queryLines": [
        "SELECT\r\n",
        "    title,\r\n",
        "    AVG(user_score) AS calificacion_promedio\r\n",
        "FROM smartdata_jeol.gold.peliculas\r\n",
        "WHERE user_score IS NOT NULL\r\n",
        "GROUP BY title\r\n",
        "ORDER BY calificacion_promedio DESC, title ASC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "c90de218",
      "displayName": "Top_5_idiomas_peliculas",
      "queryLines": [
        "SELECT\r\n",
        "    CASE language\r\n",
        "        WHEN 'en' THEN 'Inglés'\r\n",
        "        WHEN 'fr' THEN 'Francés'\r\n",
        "        WHEN 'it' THEN 'Italiano'\r\n",
        "        WHEN 'ja' THEN 'Japonés'\r\n",
        "        WHEN 'es' THEN 'Español'\r\n",
        "        ELSE language\r\n",
        "    END AS idioma,\r\n",
        "    COUNT(*) AS total_peliculas\r\n",
        "FROM smartdata_jeol.gold.peliculas\r\n",
        "WHERE language IS NOT NULL\r\n",
        "GROUP BY language\r\n",
        "ORDER BY total_peliculas DESC\r\n",
        "LIMIT 5;"
      ]
    }
  ],
